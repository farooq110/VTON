generator client {
  provider = "prisma-client-js"
}

datasource db {
  // Swap to "postgresql" + a Postgres DATABASE_URL for production.
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model Admin {
  id           String    @id @default(cuid()) @map("_id")
  email        String    @unique
  name         String
  passwordHash String
  role         String    @default("ADMIN")
  /// Issue 1 fix — franchiseId scopes settings + brand to the user's franchise.
  /// NULL means "global / no franchise" (super_admin). All non-super_admin
  /// users should have a franchiseId set so their settings are isolated.
  franchiseId  String?
  resetToken   String?
  resetExpires DateTime?
  /// 6-digit email passcode (plain text — short-lived, 10 min TTL).
  /// Used by the 2-step sign-in flow: send passcode → user types it → verify.
  passcode         String?
  passcodeExpires  DateTime?
  passcodeAttempts Int      @default(0)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

/// Boutique storefront identity — read by the frontend's HomePage to render
/// the cover banner, brand logo, brand name, and tagline ("Try then Buy").
/// One row per brand; the admin portal edits it via the Brand API.
model Brand {
  id                   String   @id @default(cuid()) @map("_id")
  name                 String
  tagline              String   @default("Try then Buy")
  logoUrl              String?
  coverBannerUrl       String?
  customName           String?
  customLogoUrl        String?
  customCoverBannerUrl String?
  primaryColor         String?  @default("#1c1917")
  accentColor          String?  @default("#d4a017")
  isActive             Boolean  @default(true)
  /// Issue 1 fix — franchiseId scopes brand identity per franchise.
  /// NULL = global (super_admin). All users under the same franchise
  /// share the same brand identity (logo, cover, name).
  franchiseId          String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

/// App-wide settings — fetched by the frontend on load via `GET /api/settings`
/// and persisted via `PUT /api/settings`.
/// Issue 1 fix — scoped per FRANCHISE (not per brand). Each franchise has its
/// own settings row. All users under the same franchise share those settings.
/// `franchiseId` is the unique key — if it's NULL, we use a synthetic
/// "global" key for super_admin users who don't belong to a specific franchise.
model Setting {
  id                       String   @id @default(cuid()) @map("_id")
  /// Issue 1 fix — franchiseId scopes settings per franchise. NULL = global.
  franchiseId              String   @unique
  currency                 String   @default("PKR")
  priceRangeMin            Int      @default(0)
  priceRangeMax            Int      @default(10000)
  personDetectionModelId   String   @default("yolov8n-pose")
  postureModelId           String   @default("yolov8n-pose")
  poseThresholds           String   @default("{\"personScore\":0.6,\"shoulderTiltDeg\":12,\"faceYawDeg\":18,\"facePitchDeg\":15,\"minBodyVisibility\":0.55}")
  personDetectionParams    String   @default("{\"confidenceThreshold\":0.6,\"nmsIouThreshold\":0.5,\"maxPersons\":10}")
  compression              String   @default("{\"maxFileSizeKb\":1000,\"minQuality\":0.7,\"qualityStep\":0.05,\"dimensionStep\":0.05,\"stripMetadata\":true,\"stripChunks\":true}")
  captureTimerSeconds      Int      @default(3)
  taglineRefreshMs         Int      @default(2400)
  productTapBehavior       String   @default("expand")
  debugLogging             Boolean  @default(false)
  telemetryEnabled         Boolean  @default(false)
  autoPreloadModel         Boolean  @default(false)
  themePrimaryColor        String   @default("#7c2d4a")
  themeAccentColor         String   @default("#c9a55c")
  themeBackgroundColor     String   @default("#faf8f5")
  themeFontFamily          String   @default("serif")
  themeBaseFontSize        String   @default("base")
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt
}

/// Garment catalog — read by the frontend's ProductsPage, TrendingProducts
/// rail, ProductDetailPage, and TRY ON flow. `trendingScore` (0–100) drives
/// the home rail ordering; `garmentOverlayUrl` is the reference image passed
/// to the TryOn AI API.
model Product {
  id                String   @id @default(cuid()) @map("_id")
  sku               String   @unique
  code              String?
  name              String
  description       String?
  price             Float    @default(0)
  currency          String   @default("USD")
  category          String?
  imageUrl          String?
  garmentOverlayUrl String?
  /// Stored as a JSON string of string[] to keep the schema provider-agnostic
  /// (works on both MongoDB and SQL providers).
  sizes             String   @default("[]")
  /// Stored as a JSON string of {name, hex}[].
  colors            String   @default("[]")
  isNew             Boolean  @default(false)
  inStock           Boolean  @default(true)
  trendingScore     Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([category])
  @@index([isNew])
  @@index([inStock])
  @@index([trendingScore])
}

/// Per-brand + per-franchise try-on request log. Written by the
/// `/api/tryon/track` endpoint (called fire-and-forget by the frontend's
/// orchestrator after every TryOn AI call). Drives the admin portal's
/// "brand request count" dashboard.
model TryOnLog {
  id          String   @id @default(cuid()) @map("_id")
  brandId     String
  franchiseId String
  userId      String
  productSku  String
  status      String   @default("success")
  durationMs  Int?
  timestamp   DateTime @default(now())
  createdAt   DateTime @default(now())

  @@index([brandId, timestamp])
  @@index([franchiseId, timestamp])
  @@index([userId])
  @@index([productSku])
}

/// Client-side diagnostic logs — POSTed by the frontend's `logger` utility
/// (fire-and-forget, only when `settings.telemetryEnabled` is true). Gives
/// the backend visibility into client-side failures (camera permission
/// denials, model load failures, network errors) that are invisible
/// server-side.
model TelemetryLog {
  id        String   @id @default(cuid()) @map("_id")
  level     String   @default("info")
  category  String
  message   String
  detail    String?
  userAgent String?
  url       String?
  timestamp DateTime @default(now())
  createdAt DateTime @default(now())

  @@index([level, timestamp])
  @@index([category, timestamp])
  @@index([timestamp])
}

model Customer {
  id            String             @id @default(cuid()) @map("_id")
  name          String
  email         String             @unique
  phone         String?
  businessName  String
  businessType  String?
  taxId         String?
  address       String?
  status        String             @default("ACTIVE")
  notes         String?
  franchises    Franchise[]
  apiKeys       ApiKey[]
  usages        Usage[]
  notifications Notification[]
  pricingTiers  CustomerPricing[]
  invoices      Invoice[]
  vtonRequests  VtonRequest[]
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  @@index([status])
}

model Franchise {
  id           String       @id @default(cuid()) @map("_id")
  name         String
  email        String?
  phone        String?
  managerName  String?
  address      String?
  status       String       @default("ACTIVE")
  customerId   String
  customer     Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  usages       Usage[]
  vtonRequests VtonRequest[]
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@index([customerId])
  @@index([status])
}

model ApiKey {
  id            String       @id @default(cuid()) @map("_id")
  keyEncrypted  String
  keyHint       String
  keyPrefix     String
  customerId    String
  customer      Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  defaultCredit Int          @default(280)
  usedCredit    Int          @default(0)
  expiresAt     DateTime
  revokedAt     DateTime?
  lastUsedAt    DateTime?
  vtonRequests  VtonRequest[]
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([customerId])
}

model Usage {
  id          String     @id @default(cuid()) @map("_id")
  customerId  String
  customer    Customer   @relation(fields: [customerId], references: [id], onDelete: Cascade)
  franchiseId String?
  franchise   Franchise? @relation(fields: [franchiseId], references: [id], onDelete: SetNull)
  apiKeyId    String?
  creditsUsed Int        @default(1)
  endpoint    String?
  method      String?
  statusCode  Int?
  ipAddress   String?
  userAgent   String?
  day         DateTime   @default(now())
  createdAt   DateTime   @default(now())

  @@index([customerId, day])
  @@index([franchiseId, day])
  @@index([apiKeyId])
}

model Notification {
  id         String    @id @default(cuid()) @map("_id")
  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: Cascade)
  type       String
  title      String
  message    String
  severity   String    @default("INFO")
  read       Boolean   @default(false)
  createdAt  DateTime  @default(now())

  @@index([customerId, read])
  @@index([createdAt])
}

model ActivityLog {
  id         String   @id @default(cuid()) @map("_id")
  level      String   @default("info")
  category   String   @default("system")
  message    String
  meta       String?
  statusCode Int?
  path       String?
  method     String?
  durationMs Int?
  ipAddress  String?
  createdAt  DateTime @default(now())

  @@index([level, createdAt])
  @@index([category, createdAt])
}

model VtonRequest {
  id           String     @id @default(cuid()) @map("_id")
  apiKeyId     String
  apiKey       ApiKey     @relation(fields: [apiKeyId], references: [id], onDelete: Cascade)
  customerId   String
  customer     Customer   @relation(fields: [customerId], references: [id], onDelete: Cascade)
  franchiseId  String?
  franchise    Franchise? @relation(fields: [franchiseId], references: [id], onDelete: SetNull)
  fashnId      String?
  inputsHash   String?
  status       String     @default("pending")
  inputs       String
  output       String?
  errorName    String?
  errorMessage String?
  creditsUsed  Int        @default(0)
  completedAt  DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([apiKeyId])
  @@index([customerId])
  @@index([franchiseId])
  @@index([fashnId])
  @@index([inputsHash])
  @@index([status, createdAt])
}

model CustomerPricing {
  id         String   @id @default(cuid()) @map("_id")
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  startRange Int
  endRange   Int
  priceCents Int
  label      String?
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([customerId])
  @@index([customerId, active])
}

model Invoice {
  id             String   @id @default(cuid()) @map("_id")
  customerId     String
  customer       Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  invoiceNumber  String   @unique
  status         String   @default("DRAFT")
  periodStart    DateTime
  periodEnd      DateTime
  totalCredits   Int      @default(0)
  lineItems      String
  totals         String
  notes          String?
  pdfUrl         String?
  sentToCustomer Boolean  @default(false)
  sentAt         DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([customerId])
  @@index([status, createdAt])
  @@index([periodStart, periodEnd])
}
