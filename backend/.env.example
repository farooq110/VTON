# Server
PORT=4000
NODE_ENV=development

# Database — MongoDB (the prisma schema uses provider = "mongodb").
# Local MongoDB:  mongodb://localhost:27017/tryon-garments
# MongoDB Atlas:  mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/vton?retryWrites=true&w=majority
DATABASE_URL=mongodb://localhost:27017/tryon-garments

# Auth — generate with: openssl rand -hex 32
JWT_SECRET=change-me-to-a-64-char-random-string-please
JWT_EXPIRES_IN=7d

# Encryption (AES-256-GCM — must be 64-char hex string = 32 bytes)
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Redis (cache + BullMQ email queue — best-effort, no-ops if unreachable)
REDIS_URL=redis://localhost:6379

# CORS (comma-separated list of allowed origins)
CORS_ORIGIN=http://localhost:5173,http://localhost:5174

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100

# Logging
LOG_LEVEL=debug

# FASHN.ai (the actual try-on AI provider)
FASHN_API_BASE_URL=https://api.fashn.ai

# TryOn AI proxy — the frontend calls POST /api/tryon/run, the backend
# forwards to this endpoint with this key. Keeps credentials off the client.
# Example: TRYON_AI_ENDPOINT=https://api.fashn.ai/v1/run
TRYON_AI_ENDPOINT=
TRYON_AI_API_KEY=
