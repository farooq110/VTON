# Server
PORT=4000
NODE_ENV=development

# Database (SQLite for dev — swap to postgresql by changing provider line + DATABASE_URL)
DATABASE_URL=file:./prisma/dev.db

# Auth
JWT_SECRET=change-me-to-a-64-char-random-string
JWT_EXPIRES_IN=7d

# Encryption (AES-256-GCM — must be 64-char hex string = 32 bytes)
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Redis (cache + BullMQ)
REDIS_URL=redis://localhost:6379

# CORS
CORS_ORIGIN=http://localhost:5173

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100

# Logging
LOG_LEVEL=debug

# FASHN.ai
FASHN_API_BASE_URL=https://api.fashn.ai
