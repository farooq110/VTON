# ──────────────────────────────────────────────────────────────────────────
# VTON Backend Environment Configuration
# ──────────────────────────────────────────────────────────────────────────
# Copy this file to `.env` and fill in the values.
# Generate secrets with: openssl rand -hex 32

# Server
PORT=4000
NODE_ENV=development

# Database — MongoDB (the prisma schema uses provider = "mongodb").
# Local MongoDB:  mongodb://localhost:27017/tryon-garments
# MongoDB Atlas:  mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/vton?retryWrites=true&w=majority
DATABASE_URL=mongodb://localhost:27017/tryon-garments

# Auth — generate with: openssl rand -hex 32
JWT_SECRET=change-me-to-a-64-char-random-string-please
JWT_EXPIRES_IN=7d

# Encryption (AES-256-GCM — must be 64-char hex string = 32 bytes)
# Used to encrypt customer API keys at rest in the database.
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Redis (cache + BullMQ email queue — best-effort, no-ops if unreachable)
REDIS_URL=redis://localhost:6379

# CORS (comma-separated list of allowed origins)
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100

# Logging
LOG_LEVEL=debug

# ──────────────────────────────────────────────────────────────────────────
# FASHN.ai (the try-on AI provider)
# ──────────────────────────────────────────────────────────────────────────
# ONLY the base URL is set from the environment.
# The API key is NOT set here — it is stored per-customer in the database
# (encrypted with ENCRYPTION_KEY) and assigned by the admin via the admin
# portal. Each try-on call resolves the customer's active API key from the
# database, decrypts it, and forwards it to FASHN.ai.
#
# To assign a key to a customer:
#   1. Log into the admin portal
#   2. Navigate to Customers → select a customer
#   3. Add an API key (the FASHN.ai key) — it is encrypted at rest
#   4. That customer's try-on calls will now use this key
FASHN_API_BASE_URL=https://api.fashn.ai

# NOTE: TRYON_AI_ENDPOINT and TRYON_AI_API_KEY are NO LONGER USED.
# The per-customer API key model replaces them. If you have old values
# set, they will be ignored.
